# Vercel AI Gateway key (vercel.com → AI tab → API Keys).
# Used for the Claude synthesis pass that turns the verbose NLA decodings
# into the chip-and-narrative payload the UI consumes.
AI_GATEWAY_API_KEY=

# Modal NLA service endpoint. Deploy modal/penny_nla.py then paste the
# `https://<workspace>--penny-nla-nla-decode.modal.run` URL here.
# Without this, /api/ask returns 502 and the client falls back to a mock.
MODAL_DECODE_URL=

# Upstash Redis (provisioned by Vercel Marketplace → Upstash for Redis).
# Used for the question cache and IP rate limiting. `vercel env pull`
# populates all four after the integration is connected to this project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=
